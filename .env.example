# SoundWave Backend — environment variables
# Copy to `.env` and fill real values. NEVER commit `.env` (see .gitignore).
# Every value here is read via settings — nothing below may be hardcoded in code
# (Constitution: Principle VI — Configuration & Secrets Hygiene).

# ---- Django core ----
DJANGO_SECRET_KEY=change-me
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ---- Database (PostgreSQL) ----
DATABASE_URL=postgres://soundwave:soundwave@localhost:5432/soundwave

# ---- Cache / quota (Redis) ----
REDIS_URL=redis://localhost:6379/0

# ---- App-level auth (Layer 1) ----
X_APP_KEY=change-me

# ---- JWT (Layer 2) — lifetimes in minutes/days (tunable, not hardcoded) ----
ACCESS_TOKEN_LIFETIME_MINUTES=30
REFRESH_TOKEN_LIFETIME_DAYS=30
JWT_MIN_SECRET_BYTES=32     # min DJANGO_SECRET_KEY length for HS256 (prod fail-fast)

# ---- Jamendo upstream (never exposed to clients) ----
JAMENDO_CLIENT_ID=change-me
JAMENDO_API_BASE_URL=https://api.jamendo.com/v3.0
JAMENDO_REQUEST_TIMEOUT_SECONDS=5
JAMENDO_AUDIOFORMAT=mp31
JAMENDO_TRENDING_ORDER=popularity_total   # popularity_month/week trả rỗng ở free tier

# ---- Catalog cache TTLs (seconds) ----
CACHE_TTL_TRENDING=3600
CACHE_TTL_GENRES=86400
CACHE_TTL_SEARCH=120
CACHE_TTL_DETAIL=1800

# ---- Social login ----
GOOGLE_OAUTH_CLIENT_ID=change-me
APPLE_CLIENT_ID=change-me
APPLE_TEAM_ID=change-me
APPLE_KEY_ID=change-me

# ---- Rate limiting (requests per period, tunable — BE-004) ----
THROTTLE_AUTH=10/min       # /auth/* per-IP (brute-force guard)
THROTTLE_CATALOG=120/min   # GET /catalog/* per-IP
THROTTLE_USER=60/min       # write /me/* per-user
THROTTLE_HISTORY=120/min   # POST /me/history per-user (rapid skips)
NUM_PROXIES=0              # trusted proxy hops for client-IP (raise behind LB/proxy)

# ---- CORS (explicit allowlist — never * in production) ----
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ---- Observability ----
SENTRY_DSN=
